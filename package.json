{
  "name": "1click-temp-mail-autofill-form",
  "version": "3.0.0",
  "description": "Generate temporary email addresses and auto-fill OTPs and login forms with one click.",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "echo ✔ Starting the Chrome dev server. && echo 💡 Firefox: bun run dev:firefox && echo 💡 Safari: bun run dev:safari && wxt",
    "dev:demo": "bun scripts/demo-server.ts",
    "build:web-demo": "bun scripts/build-web-demo.ts",
    "preview:web-demo": "bun scripts/serve-web-demo.ts",
    "test:web-demo": "bun x playwright test --config=playwright.web-demo.config.ts",
    "dev:chrome": "wxt --browser chrome",
    "dev:firefox": "wxt --browser firefox",
    "dev:safari": "wxt --browser safari",
    "build": "bun run build:chrome && echo ✔ Chrome build complete. By default build targets Chrome only - edit package.json to change it. && echo 💡 Build Firefox or Safari individually: bun run build:firefox, bun run build:safari. && echo 💡 Build for all platforms - Chrome, Firefox, Safari: bun run build:all. && bun scripts/check-stale-builds.ts --browser chrome",
    "build:chrome": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox",
    "build:safari": "wxt build --browser safari",
    "build:all": "bun run build:chrome && bun run build:firefox && bun run build:safari && bun run check-nav-flags && bun scripts/check-stale-builds.ts",
    "zip": "bun run zip:chrome && echo ✔ Chrome zip complete. By default zip targets Chrome only - edit package.json to change it. && echo 💡 Firefox: bun run zip:firefox && echo 💡 Safari: bun run zip:safari && echo 💡 All three browsers: bun run zip:all && echo 💡 Safari store upload zip: bun run package:safari",
    "zip:chrome": "wxt zip --browser chrome",
    "zip:firefox": "wxt zip --browser firefox",
    "zip:safari": "wxt zip --browser safari",
    "zip:all": "bun run zip:chrome && bun run zip:firefox && bun run zip:safari",
    "package:safari": "bun run build:safari && bun scripts/package-safari.ts",
    "prepare": "wxt prepare && lefthook install",
    "clean": "wxt clean",
    "typecheck": "svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json && tsc --noEmit -p ./tsconfig.ts-only.json",
    "format": "bun x biome format --write",
    "check": "bun x biome check --error-on-warnings",
    "check-translations": "bun scripts/check-translations.ts",
    "check-terminology-drift": "bun scripts/check-terminology-drift.ts",
    "check-mirror-locales": "bun scripts/mirror-locales.ts --check",
    "check-unused-locales": "bun scripts/check-unused-locales.ts",
    "check-locale-key-references": "bun scripts/check-locale-key-references.ts",
    "check-plural-keys": "bun scripts/check-plural-keys.ts",
    "audit-row-surfaces": "bun scripts/audit-row-surfaces.ts",
    "audit-z-layers": "bun scripts/audit-z-layers.ts",
    "check-hardcoded-english": "bun scripts/check-hardcoded-english.ts",
    "check-i18n-fit": "bun scripts/check-i18n-fit.ts",
    "generate-background-locales": "bun scripts/generate-background-locales.ts",
    "check-background-locales": "bun scripts/generate-background-locales.ts --check",
    "check-locale-messages": "bun scripts/generate-locale-messages.ts --check",
    "generate-locale-messages": "bun scripts/generate-locale-messages.ts",
    "check-branch-protection": "bun scripts/check-branch-protection.ts",
    "generate-responsive-button-layout-module": "bun scripts/generate-responsive-button-layout-module.ts",
    "check-responsive-button-layout-module": "bun scripts/generate-responsive-button-layout-module.ts --check",
    "check:responsive-button-layout": "bun scripts/check-responsive-button-layout-visual.ts",
    "check:responsive-button-layout:webkit": "bun scripts/check-responsive-button-layout-visual.ts webkit",
    "check:responsive-button-layout:firefox": "bun scripts/check-responsive-button-layout-firefox.ts",
    "check-message-types": "bun scripts/check-message-types.ts",
    "check-mock-restore": "bun scripts/check-mock-restore.ts",
    "check-layer-tokens": "bun scripts/check-layer-tokens.ts",
    "check-state-layers": "bun scripts/check-state-layers.ts",
    "check-ui-typography": "bun scripts/check-ui-typography.ts",
    "check-pseudo-overlays": "bun scripts/check-pseudo-overlays.ts",
    "check-avatar-sizes": "bun scripts/check-avatar-sizes.ts",
    "check-icon-references": "bun scripts/check-icon-references.ts",
    "check-vocabulary-fields": "bun scripts/check-vocabulary-fields.ts",
    "check-nav-flags": "bun scripts/check-nav-flags.ts",
    "check-providers": "bun scripts/check-providers.ts",
    "check-stale-builds": "bun scripts/check-stale-builds.ts",
    "check-suppressions": "bun scripts/check-suppressions.ts",
    "check-storage-namespace-drift": "bun scripts/check-storage-namespace-drift.ts",
    "check-storage-rmw": "bun scripts/check-storage-rmw.ts",
    "check-stale-caches": "bun scripts/check-stale-caches.ts",
    "check-undo-guards": "bun scripts/check-undo-guards.ts",
    "check-version-parity": "bun scripts/check-version-parity.ts",
    "check-tsconfig-coverage": "bun scripts/check-tsconfig-coverage.ts",
    "audit": "bun scripts/audit.ts",
    "generate-content-theme": "bun scripts/generate-content-theme.ts",
    "generate-theme": "bun scripts/generate-theme.ts",
    "mirror-locales": "bun scripts/mirror-locales.ts",
    "test": "bun x rimraf .wxt/component-test-modules && bun test --isolate tests",
    "test:parallel": "bun x rimraf .wxt/component-test-modules && bun test tests --parallel",
    "test:watch": "bun test --isolate --watch tests",
    "test:coverage": "bun test --isolate --coverage tests",
    "test:e2e": "bun x playwright test",
    "test:e2e:ui": "bun x playwright test --ui",
    "test:e2e:headed": "bun x playwright test --headed",
    "test:live:runsignup": "bun x playwright test --config=playwright.live.config.ts",
    "test:e2e:firefox": "bun scripts/e2e-firefox.ts",
    "test:e2e:webkit": "bun x playwright test --config=playwright.webkit.config.ts",
    "test:e2e:mirror": "bun x playwright test --config=playwright.mirror.config.ts",
    "test:e2e:firefox:ui": "bun run test:e2e:mirror --project=mirror-firefox",
    "test:e2e:safari:ui": "bun run test:e2e:mirror --project=mirror-safari-webkit",
    "docs:build": "bun scripts/docs-build.ts",
    "docs:preview": "bun scripts/docs-preview.ts",
    "docs:check-links": "bun scripts/docs-check-links.ts",
    "docs:screenshots": "bun run build && bun x playwright test tests/e2e/docs-screenshots.e2e.ts --project=extension-chrome",
    "probe:icons": "bun run build && bun x playwright test tests/e2e/icon-render.e2e.ts --project=extension-chrome",
    "docs:validate": "bun run docs:build && bun run docs:check-links",
    "bump-version": "bun scripts/bump-version.ts",
    "all": "bun run format && bun run audit && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "css-tree": "^3.2.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.2",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/jsdom": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "bun-types": "^1.4.3",
    "jsdom": "^30.1.3",
    "jsonc-parser": "^3.3.1",
    "lefthook": "^2.2.2",
    "rimraf": "^6.1.3",
    "selenium-webdriver": "^4.51.0",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "temp-mail",
    "autofill",
    "otp",
    "email"
  ],
  "author": "UnarchiveTech",
  "license": "MIT"
}
